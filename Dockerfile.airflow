FROM apache/airflow:2.8.4-python3.11

USER root

ENV DEBIAN_FRONTEND=noninteractive

# Install Java 17, procps and bash
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      openjdk-17-jdk-headless \
      procps \
      bash && \
    rm -rf /var/lib/apt/lists/*

# Architecture-independent Java path
RUN ln -s "$(dirname "$(dirname "$(readlink -f "$(command -v java)")")")" /opt/java

ENV JAVA_HOME=/opt/java
ENV PATH="${JAVA_HOME}/bin:${PATH}"

WORKDIR /app

# Keep project/MLflow dependencies out of Airflow's Python environment.
# In particular, Airflow's Flask-AppBuilder and MLflow's Pydantic dependencies
# cannot safely share email-validator versions.
COPY --chown=airflow:root --chmod=644 requirements.txt ./
RUN mkdir -p /opt/project-venv && chown airflow:root /opt/project-venv

USER airflow

RUN python -m venv /opt/project-venv && \
    PIP_USER=false /opt/project-venv/bin/pip install --no-cache-dir -r requirements.txt
